{
  "name": "pawblossom-puzzle",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run assets:check && npm run typecheck && vite build",
    "build:test": "npm run assets:check && npm run typecheck && vite build --mode testing",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json && tsc -p tsconfig.server.json",
    "assets:generate": "node scripts/generate-launcher-assets.mjs",
    "assets:check": "node scripts/generate-launcher-assets.mjs --check",
    "store:check": "node scripts/check-store-assets.mjs && node scripts/check-pip-icon.mjs",
    "store:test": "node --test scripts/store-assets-qa.mjs scripts/pip-icon-qa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "balance:report": "node scripts/balance-report.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:sync:test": "npm run build:test && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "8.5.3",
    "@fontsource/fraunces": "^5.2.0",
    "@fontsource/nunito": "^5.2.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "24.10.1",
    "typescript": "~5.9.3",
    "vite": "8.3.3",
    "vitest": "^4.0.0"
  }
}
